{
  "name": "cadgang",
  "version": "0.10.5",
  "description": "CADgang — a CAD viewer and markup tool. Opens STEP, IGES, BREP, STL, OBJ, PLY, 3MF, glTF, FBX and DXF; sections, measures with snaps, markups Claude Code can see over MCP. Web page or Mac app.",
  "type": "module",
  "private": true,
  "main": "src/server/index.js",
  "bin": {
    "cadgang-mcp-server": "src/mcp/index.js"
  },
  "scripts": {
    "start": "node src/server/supervise.js",
    "serve": "node src/server/index.js",
    "mcp": "node src/mcp/index.js",
    "build": "bash mac/build.sh",
    "release": "bash mac/release.sh",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "occt-import-js": "^0.0.23",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "three": "^0.165.0"
  }
}
