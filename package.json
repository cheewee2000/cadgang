{
  "name": "cadgang",
  "version": "0.7.0-alpha.19",
  "description": "cadgang — a web-based CAD tool with two lineages in one node graph: exact B-rep (STEP) and implicit fields (STL), driven by an MCP server",
  "type": "module",
  "private": true,
  "main": "src/server/index.js",
  "bin": {
    "cadgang-mcp-server": "src/mcp/index.js"
  },
  "scripts": {
    "start": "node src/server/supervise.js",
    "serve": "node src/server/index.js",
    "mcp": "node src/mcp/index.js",
    "demo": "node examples/demo.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "occt-import-js": "^0.0.23",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "three": "^0.165.0"
  }
}
